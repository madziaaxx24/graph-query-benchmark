PREFIX sn:  <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?personId
WHERE {
  ?person rdf:type sn:Person ;
          sn:id ?personId .

  FILTER NOT EXISTS {
    ?post rdf:type sn:Post ;
          sn:hasCreator ?person .
  }
}
ORDER BY ?personId
LIMIT 10