PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>

SELECT ?personId (COUNT(DISTINCT ?friend) AS ?friendCount)
WHERE {
  ?person a sn:Person ;
          sn:id ?personId .
  OPTIONAL {
    ?person sn:knows ?knows .
    ?knows sn:hasPerson ?friend .
  }
}
GROUP BY ?personId
ORDER BY DESC(?friendCount) ?personId
LIMIT 10