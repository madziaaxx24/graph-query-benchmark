PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>

SELECT ?personId (COUNT(DISTINCT ?friend) AS ?localFriendsCount)
WHERE {
?person a sn:Person ;
sn:id ?personId ;
sn:isLocatedIn ?location .

?person sn:knows ?knowsEdge .
?knowsEdge sn:hasPerson ?friend .

?friend sn:isLocatedIn ?location .
}
GROUP BY ?personId
ORDER BY DESC(?localFriendsCount) ?personId
LIMIT 10