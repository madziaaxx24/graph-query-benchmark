PREFIX sn:  <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?personId (COUNT(?post) AS ?postCount)
WHERE {
  ?post rdf:type sn:Post ;
        sn:hasCreator ?person .

  ?person rdf:type sn:Person ;
          sn:id ?personId .
}
GROUP BY ?personId
ORDER BY DESC(?postCount)
LIMIT 10