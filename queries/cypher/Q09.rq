PREFIX sn:  <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?personId ?contentId ?locationId
WHERE {
  ?person sn:id ?personId ;
          sn:isLocatedIn ?location .

  ?location sn:id ?locationId .

  ?content sn:id ?contentId ;
           sn:hasCreator ?person ;
           sn:creationDate ?creationDate .

  {
    ?content rdf:type sn:Post .
  }
  UNION
  {
    ?content rdf:type sn:Comment .
  }

  FILTER(?creationDate >= "2012-01-01T00:00:00"^^xsd:dateTime)
}
ORDER BY DESC(?creationDate)
LIMIT 10