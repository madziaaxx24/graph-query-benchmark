PREFIX sn:  <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?personId ?postId ?locationId
WHERE {
  ?post rdf:type sn:Post ;
        sn:id ?postId ;
        sn:hasCreator ?person .

  ?person rdf:type sn:Person ;
          sn:id ?personId ;
          sn:isLocatedIn ?location .

  ?location sn:id ?locationId .
}
ORDER BY ?personId ?postId ?locationId
LIMIT 10